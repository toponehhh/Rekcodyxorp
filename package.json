{
  "name": "docker-hub-cloudflare-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "A streaming Docker Hub pull proxy for Cloudflare Pages and Workers",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "dev:worker": "wrangler dev --config wrangler.worker.jsonc",
    "deploy:worker": "wrangler deploy --config wrangler.worker.jsonc",
    "deploy:worker:dry-run": "wrangler deploy --dry-run --config wrangler.worker.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
